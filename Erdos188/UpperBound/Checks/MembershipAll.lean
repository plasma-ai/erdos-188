/-!
# Membership chained walk

The 10 block theorems chained through `membershipStep_chain` into the walk over
all 40577 cover sites of `cover_sites.tsv`, the equation between the flattened
cover site tree and the concatenation of the block lists, and the inclusion of
the cover family in the union of the base and micro wire families
(`F_subset_B_union_M_real`). The three tables are exact assets of the 42-term
construction under
`data/k42/`.
Cover table SHA-256: `6d2115abac144af8a3f1da30d2ea235f0ef8b6ec74a28450dee606027af81cef`.
Base table SHA-256: `7a8231e89a49e6362114a1972b96b5580d3e56f5da21f23f2e10e54f894f5f9e`.
Micro table SHA-256: `4af5864472f88e5f65215c1ff5088ab08193113841d9ce09ea872fdd6ba28877`.
Generated by `gen_membership_chunks.py` under
`scripts/lean_generators/`; do not edit by hand.
No claim identity is asserted in this module.
-/

set_option autoImplicit false
set_option maxRecDepth 100000

namespace Erdos188.UpperBound

/-- Every cover site in order: the 10 block lists concatenated. -/
def coverSitesListAll : List SiteWire :=
  coverSites_000.toList ++ coverSites_001.toList ++ coverSites_002.toList ++
  coverSites_003.toList ++ coverSites_004.toList ++ coverSites_005.toList ++
  coverSites_006.toList ++ coverSites_007.toList ++ coverSites_008.toList ++ coverSites_009.toList

/-- The whole cover table walks from the initial cursor pair to the exhausted pair. -/
theorem membership_real :
    membershipStep routesSitesB routesSitesM routesDepthB routesDepthM membershipState_000
      coverSitesListAll = some membershipState_010 := by
  have chain_001 := membershipStep_chain membership_000 membership_001
  have chain_002 := membershipStep_chain chain_001 membership_002
  have chain_003 := membershipStep_chain chain_002 membership_003
  have chain_004 := membershipStep_chain chain_003 membership_004
  have chain_005 := membershipStep_chain chain_004 membership_005
  have chain_006 := membershipStep_chain chain_005 membership_006
  have chain_007 := membershipStep_chain chain_006 membership_007
  have chain_008 := membershipStep_chain chain_007 membership_008
  have chain_009 := membershipStep_chain chain_008 membership_009
  exact chain_009

/-- The flattened cover site tree is the concatenation of its block lists; the top tree
has the block subtrees and `empty` slots at its leaves, so only `SiteTree.toList` on
nodes and `empty` is unfolded. -/
theorem coverSiteTree_toList : coverSiteTree.toList = coverSitesListAll := by
  simp only [coverSiteTree, coverSitesListAll, SiteTree.toList, List.append_nil,
    List.append_assoc]

/-- Every cover site is stored in the base table or in the micro table. -/
theorem coverSiteTree_mem_base_or_micro :
    ∀ site ∈ coverSiteTree.toList, site ∈ routesSitesB.toList ∨ site ∈ routesSitesM.toList := by
  rw [coverSiteTree_toList]
  exact membershipStep_sound routesSitesB routesSitesM routesDepthB routesDepthM
    coverSitesListAll membershipState_000 membershipState_010 membership_real

/-- The literal cover family lies in the union of the literal base and micro families. -/
theorem F_subset_B_union_M_real :
    coverSiteSet coverSiteTree ⊆ wireSet routesSitesB.toList ∪ wireSet routesSitesM.toList :=
  coverSiteSet_subset_wireSet_union coverSiteTree routesSitesB routesSitesM
    coverSiteTree_mem_base_or_micro

end Erdos188.UpperBound
