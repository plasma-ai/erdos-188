/-- The whole O3 section replays from the root product to no pending obligation. -/
theorem safetyStream_O3 :
    safetyStep famO3L famO3R [.node 0 10108 0 11064 511] recordsO3All =
      some [] :=
  safetyStepFast_sound famO3L famO3R boxTableO3A boxTableO3B boxCheckO3A
    boxCheckO3B recordsO3All _ _ safetyStreamFast_O3

/-- The periodic union of the carriers sites (role S) is unit independent. -/
theorem unitIndependent_S_real : UnitIndependent (U (wireSet routesSitesS.toList)) :=
  unitIndependent_U_of_safetyPieces famO1 recordsO1All routesSitesS_shape
    (surjCheck_sound_all surjO1) routesSitesS_valid safetyStream_O1

/-- The periodic union of the base sites (role B) is unit independent. -/
theorem unitIndependent_B_real : UnitIndependent (U (wireSet routesSitesB.toList)) :=
  unitIndependent_U_of_safetyPieces famO2 recordsO2All routesSitesB_shape
    (surjCheck_sound_all surjO2) routesSitesB_valid safetyStream_O2

/-- The periodic unions of the micro_representatives sites (role M) and the
plugs sites (role P) are cross-safe. -/
theorem crossSafe_MP_real :
    CrossSafe (U (wireSet routesSitesM.toList)) (U (wireSet routesSitesP.toList)) :=
  crossSafe_U_of_safetyPieces famO3L famO3R recordsO3All routesSitesM_shape
    routesSitesP_shape (surjCheck_sound_all surjO3L) (surjCheck_sound_all surjO3R)
    routesSitesM_valid routesSitesP_valid safetyStream_O3

